# Custom health check message
PING_MESSAGE=pong

# Skip login/signup (local dev / preview only)
# Auth is enabled when AUTH_DISABLED is unset. Standalone production deploys
# need a stable BETTER_AUTH_SECRET; BETTER_AUTH_URL is inferred automatically.
# BETTER_AUTH_SECRET=
# AUTH_DISABLED=true

# --- HireCheck ---
# Nebius Token Factory (dev.nebius.com/builders) and Tavily keys
NEBIUS_API_KEY=
TAVILY_API_KEY=
# Optional model overrides
# HIRECHECK_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017
# HIRECHECK_FALLBACK_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507

# The chat agent runs on Token Factory through its OpenAI-compatible endpoint
AGENT_ENGINE=ai-sdk:openai
AGENT_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
OPENAI_BASE_URL=https://api.tokenfactory.nebius.com/v1
OPENAI_API_KEY=   # same value as NEBIUS_API_KEY
